{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asistente.local/contrato/v1/token-respuesta.schema.json",
  "title": "Respuesta de la ruta de emisión de token",
  "type": "object",
  "required": ["token", "expira"],
  "properties": {
    "token": { "type": "string", "minLength": 1 },
    "expira": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
