{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asistente.local/contrato/v1/confirmar-respuesta.schema.json",
  "title": "Respuesta de `POST /v1/confirmaciones/{id}/confirmar` del asistente (no la implementa el sistema anfitrión)",
  "oneOf": [
    {
      "type": "object",
      "required": ["estado", "ok", "mensaje"],
      "properties": {
        "estado": { "const": "ejecutada" },
        "ok": { "const": true },
        "mensaje": { "type": "string", "maxLength": 300, "description": "`datos.mensaje` de la ejecución del sistema." },
        "ui": { "type": "array" }
      }
    },
    {
      "type": "object",
      "required": ["estado", "ok", "error"],
      "properties": {
        "estado": { "const": "fallida" },
        "ok": { "const": false },
        "error": { "type": "string" },
        "detalle": { "type": "string", "maxLength": 300 }
      }
    }
  ]
}
