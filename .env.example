# Copiar a .env. Un .env por host (dev local o VPS); no se versiona. En Dockge, el .env del stack.
LLM_PROVEEDOR=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
ASISTENTE_MODELO_DEFAULT=
# Vacío = /admin/* deshabilitado (503). En prod: openssl rand -hex 32
ASISTENTE_ADMIN_TOKEN=
# Solo prod (el compose de dev usa credenciales fijas). Obligatoria: openssl rand -hex 24
POSTGRES_PASSWORD=
# Solo prod: puerto en loopback para el proxy del host (docker-compose.prod.yml)
#ASISTENTE_PUERTO=8000
# Solo prod: etiqueta de la imagen construida (la fija deploy/deploy.sh)
#ASISTENTE_VERSION=latest
# Por sistema (nombres referenciados desde config/sistemas.yaml). Ejemplo: sistema-php de dev
# PHP_SECRETO=secreto-php-0123456789-0123456789-ab
# PHP_MANIFEST_TOKEN=manifiesto-php
# En producción, RS256: <SISTEMA>_PUBKEY=<PEM de la clave pública>
# --- Voz: dictado. Vacío = deshabilitado ---
# En prod, para levantar whisper local: COMPOSE_PROFILES=voz
#COMPOSE_PROFILES=voz
# Whisper local (dev): docker compose -f docker-compose.dev.yml --profile voz up
#STT_PROVEEDOR=openai_compat
#STT_BASE_URL=http://whisper:8000/v1
#STT_MODELO=Systran/faster-whisper-small
#STT_API_KEY=
# Contenedor Whisper (perfil voz); WHISPER_MODELO debe coincidir con STT_MODELO
#WHISPER_MODELO=Systran/faster-whisper-small
#WHISPER_DEVICE=cpu
#WHISPER_IMAGEN=ghcr.io/speaches-ai/speaches:latest-cpu@sha256:...
# Topes del audio recibido y rate limit por usuario
#ASISTENTE_VOZ_MAX_AUDIO_KB=2048
#ASISTENTE_VOZ_MAX_AUDIO_S=60
#ASISTENTE_VOZ_MAX_POR_MIN=10

# Respuesta hablada (TTS). Sin TTS_PROVEEDOR el widget usa solo la voz del navegador.
TTS_PROVEEDOR=elevenlabs
TTS_API_KEY=
TTS_VOZ_ID=
TTS_MODELO=eleven_flash_v2_5
