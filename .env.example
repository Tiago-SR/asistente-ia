# Copiar a .env (dev o prod, según el compose; en Dockge, el .env del stack). Nunca commitear los reales.
LLM_PROVEEDOR=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
ASISTENTE_MODELO_DEFAULT=
ASISTENTE_ADMIN_TOKEN=cambiar-en-prod
# Solo prod:
POSTGRES_PASSWORD=
# Por sistema (referenciadas desde config/sistemas.yaml):
# SGA_A_PUBKEY=
# SGA_A_MANIFEST_TOKEN=
# --- Voz: dictado (Fase 4). Vacío = deshabilitado ---
# Whisper local (solo dev): docker compose -f docker-compose.dev.yml --profile voz up
#STT_PROVEEDOR=openai_compat
#STT_BASE_URL=http://whisper:8000/v1
#STT_MODELO=Systran/faster-whisper-small
#STT_API_KEY=
# Contenedor Whisper (perfil voz); WHISPER_MODELO debe coincidir con STT_MODELO
#WHISPER_MODELO=Systran/faster-whisper-small
#WHISPER_DEVICE=cpu
#WHISPER_IMAGEN=ghcr.io/speaches-ai/speaches:latest-cpu
# Topes del audio recibido y rate limit por usuario
#ASISTENTE_VOZ_MAX_AUDIO_KB=2048
#ASISTENTE_VOZ_MAX_AUDIO_S=60
#ASISTENTE_VOZ_MAX_POR_MIN=10
