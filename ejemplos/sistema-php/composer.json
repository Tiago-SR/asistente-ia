{
    "name": "ejemplo/sistema-php-asistente",
    "description": "Implementación de referencia en PHP del contrato de integración del asistente",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^7.0",
        "opis/json-schema": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Ejemplo\\": "src/" }
    },
    "scripts": {
        "test": "phpunit --colors=never"
    },
    "config": { "sort-packages": true }
}
